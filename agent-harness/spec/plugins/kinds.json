        "type": "object"
       }
      },
      "required": [
       "session",
       "action"
      ],
      "additionalProperties": true
     },
     "output": {
      "type": "object",
      "properties": {
       "observation": {
        "type": "object"
       }
      },
      "required": [
       "observation"
      ],
      "additionalProperties": true
     },
     "sample": {
      "session": "s1",
      "action": {
       "type": "noop"
      }
     },
     "timeout_s": 30,
     "effect": "write",
     "purpose": "Perform one action (a click, a key, a scroll) in a session.",
     "returns_doc": "observation: the screen after the action. The action must have a `type`.",
     "errors": [
      {
       "code": "invalid_argument",
       "when": "The action has no type. This is checked before the session is looked up.",
       "probe": {
        "session": "__no_such_session__",
        "action": {}
       }
      },
      {
       "code": "not_found",
       "when": "The session does not exist or was closed.",
       "probe": {
        "session": "__no_such_session__",
        "action": {
         "type": "noop"
        }
       }
      },
      {
       "code": "unavailable",
       "when": "The display is not reachable.",
       "probe": null
      }
     ]
    },
    "close": {
     "input": {
      "type": "object",
      "properties": {
       "session": {
        "type": "string"
       }
      },
      "required": [
       "session"
      ],
      "additionalProperties": true
     },
     "output": {
      "type": "object",
      "properties": {
       "closed": {
        "type": "boolean"
       }
      },
      "required": [
       "closed"
      ],
      "additionalProperties": true
     },
     "sample": {
      "session": "s1"
     },
     "timeout_s": 30,
     "effect": "write",
     "purpose": "Close a session.",
     "returns_doc": "closed: true. Closing releases the display, and the session id is not valid afterwards.",
     "errors": [
      {
       "code": "not_found",
       "when": "The session does not exist.",
       "probe": {
        "session": "__no_such_session__"
       }
      }
     ]
    }
   }
  },
