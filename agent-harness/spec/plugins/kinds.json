     "purpose": "Predict the user's next action from the context.",
     "returns_doc": "prediction (any object) and confidence in [0, 1]. A user with no observations gets confidence 0, not an error.",
     "errors": [
      {
       "code": "invalid_argument",
       "when": "The user id is empty.",
       "probe": {
        "user": "",
