        "type": "object"
       }
      },
      "required": [
       "observation"
      ],
      "additionalProperties": true
     },
     "sample": {
      "session": "s1"
     },
     "timeout_s": 30,
     "effect": "read_only",
     "purpose": "Read the current screen of a session.",
     "returns_doc": "observation: what is on the screen, as an object.",
     "errors": [
      {
       "code": "not_found",
       "when": "The session does not exist or was closed.",
       "probe": {
        "session": "__no_such_session__"
       }
      },
      {
       "code": "unavailable",
       "when": "The display is not reachable.",
       "probe": null
      }
     ]
    },
    "act": {
     "input": {
      "type": "object",
