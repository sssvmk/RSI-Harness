    "open": {
     "input": {
      "type": "object",
      "properties": {
       "spec": {
        "type": "object"
       }
      },
      "required": [
       "spec"
      ],
      "additionalProperties": true
     },
     "output": {
      "type": "object",
      "properties": {
       "session": {
        "type": "string"
       }
      },
      "required": [
       "session"
      ],
      "additionalProperties": true
     },
     "sample": {
      "spec": {}
     },
     "timeout_s": 60,
     "effect": "write",
     "purpose": "Open a session on a virtual display.",
     "returns_doc": "session: an id that observe, act and close accept until the session is closed.",
