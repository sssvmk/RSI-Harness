{
 "schema_version": 1,
 "kinds": {
  "proposer": {
   "interface_version": "1.0.0",
   "summary": "Self-improvement: proposes harness edits and mines weaknesses. Needs a model.",
   "trust": "untrusted_output",
   "min_profile": "core",
   "grants": [
    "model_calls"
   ],
   "methods": {
    "describe": {
     "input": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": true
     },
     "output": {
      "type": "object",
      "properties": {
       "id": {
        "type": "string"
       },
       "kind": {
        "type": "string"
       },
       "version": {
        "type": "string"
       }
      },
      "required": [
       "id",
       "kind",
       "version"
      ],
      "additionalProperties": true
     },
     "sample": {},
     "timeout_s": 5,
     "effect": "read_only",
     "purpose": "Say who the plugin is.",
     "returns_doc": "id, kind and version, which must equal the manifest's.",
     "errors": []
    },
    "health": {
     "input": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": true
     },
     "output": {
      "type": "object",
      "properties": {
       "ok": {
        "type": "boolean"
       }
      },
      "required": [
       "ok"
      ],
      "additionalProperties": true
     },
     "sample": {},
     "timeout_s": 5,
     "effect": "read_only",
     "purpose": "Say whether the plugin can serve calls now.",
     "returns_doc": "ok: false when the plugin cannot serve calls. Health reports a problem and never raises one.",
     "errors": []
    },
    "propose": {
     "input": {
      "type": "object",
      "properties": {
       "round": {
        "type": "integer"
       },
       "n": {
        "type": "integer"
       },
       "base": {
        "type": "string"
       },
       "ctx": {
        "type": "object"
       }
      },
      "required": [
       "round",
       "n",
       "base",
       "ctx"
      ],
      "additionalProperties": true
     },
     "output": {
      "type": "object",
      "properties": {
       "proposals": {
        "type": "array",
        "items": {
         "type": "object",
         "properties": {
          "edits": {
           "type": "array"
          },
          "manifest": {
           "type": "object"
          }
         },
         "required": [
          "edits",
          "manifest"
         ],
         "additionalProperties": true
        }
       }
      },
      "required": [
       "proposals"
      ],
      "additionalProperties": true
     },
     "sample": {
      "round": 1,
      "n": 1,
      "base": "c0",
      "ctx": {}
     },
     "timeout_s": 120,
     "effect": "read_only",
     "purpose": "Propose harness edits for a round of self-improvement.",
     "returns_doc": "proposals: at most n, each with its edits and a manifest.",
     "errors": [
      {
       "code": "invalid_argument",
       "when": "n is below 1.",
       "probe": {
        "round": 1,
        "n": 0,
        "base": "c0",
        "ctx": {}
       }
      },
      {
       "code": "unavailable",
       "when": "The model is down.",
       "probe": null
      },
      {
       "code": "rate_limited",
       "when": "The model refused the call for now.",
       "probe": null
      }
     ]
    },
    "analyze_weakness": {
     "input": {
      "type": "object",
      "properties": {
       "report": {
        "type": "object"
       }
      },
      "required": [
       "report"
      ],
      "additionalProperties": true
     },
     "output": {
      "type": "object",
      "properties": {
       "findings": {
        "type": "array"
       }
      },
      "required": [
       "findings"
      ],
      "additionalProperties": true
     },
     "sample": {
      "report": {}
     },
     "timeout_s": 120,
     "effect": "read_only",
     "purpose": "Find weaknesses in an evaluation report.",
     "returns_doc": "findings: a list, possibly empty.",
     "errors": [
      {
       "code": "unavailable",
       "when": "The model is down.",
       "probe": null
      }
     ]
    }
   }
  },
  "retrieval": {
   "interface_version": "1.0.0",
   "summary": "Knowledge retrieval over an index. Needs an embedding model and an index. Passages are untrusted; access control is enforced by the plugin and checked again by the harness.",
   "trust": "untrusted_output",
   "min_profile": "core",
   "grants": [
    "model_calls"
   ],
   "methods": {
    "describe": {
     "input": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": true
     },
     "output": {
      "type": "object",
      "properties": {
       "id": {
        "type": "string"
       },
       "kind": {
        "type": "string"
       },
       "version": {
        "type": "string"
       }
      },
      "required": [
       "id",
       "kind",
       "version"
      ],
      "additionalProperties": true
     },
     "sample": {},
     "timeout_s": 5,
     "effect": "read_only",
     "purpose": "Say who the plugin is.",
     "returns_doc": "id, kind and version, which must equal the manifest's.",
     "errors": []
    },
    "health": {
     "input": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": true
     },
     "output": {
      "type": "object",
      "properties": {
       "ok": {
        "type": "boolean"
       }
      },
      "required": [
       "ok"
      ],
      "additionalProperties": true
     },
     "sample": {},
     "timeout_s": 5,
     "effect": "read_only",
     "purpose": "Say whether the plugin can serve calls now.",
     "returns_doc": "ok: false when the plugin cannot serve calls. Health reports a problem and never raises one.",
     "errors": []
    },
    "index": {
     "input": {
      "type": "object",
      "properties": {
       "documents": {
        "type": "array",
        "items": {
         "type": "object",
         "properties": {
          "id": {
           "type": "string"
          },
          "text": {
           "type": "string"
          }
         },
         "required": [
          "id",
          "text"
         ],
         "additionalProperties": true
        }
       }
      },
      "required": [
       "documents"
      ],
      "additionalProperties": true
     },
     "output": {
      "type": "object",
      "properties": {
       "indexed": {
        "type": "integer"
       },
       "index_version": {
        "type": "string"
       }
      },
      "required": [
       "indexed",
       "index_version"
      ],
      "additionalProperties": true
     },
     "sample": {
      "documents": [
       {
        "id": "__conformance_doc__",
        "text": "conformance check"
       }
      ]
     },
     "timeout_s": 120,
     "effect": "write",
     "purpose": "Add or replace documents in the index.",
     "returns_doc": "indexed (the number of documents now in the index from this call) and index_version (changes whenever the index content changes).",
     "errors": [
      {
       "code": "invalid_argument",
       "when": "A document has an empty id or empty text.",
       "probe": {
        "documents": [
         {
          "id": "",
          "text": "x"
         }
        ]
       }
      },
      {
       "code": "unavailable",
       "when": "The index backend is down.",
       "probe": null
      }
     ]
    },
    "query": {
     "input": {
      "type": "object",
      "properties": {
       "user": {
        "type": "string"
       },
       "query": {
        "type": "string"
       },
       "k": {
        "type": "integer"
       },
       "filters": {
        "type": "object"
       }
      },
      "required": [
       "user",
       "query",
       "k",
       "filters"
      ],
      "additionalProperties": true
     },
     "output": {
      "type": "object",
      "properties": {
       "passages": {
        "type": "array",
        "items": {
         "type": "object",
         "properties": {
          "id": {
           "type": "string"
          },
          "text": {
           "type": "string"
          },
          "score": {
           "type": "number"
          },
          "source": {
           "type": "string"
          },
          "permissions": {
           "type": "object"
          }
         },
         "required": [
          "id",
          "text",
          "score",
          "source",
          "permissions"
         ],
         "additionalProperties": true
        }
       }
      },
      "required": [
       "passages"
      ],
      "additionalProperties": true
     },
     "sample": {
      "user": "u",
      "query": "hello",
      "k": 3,
      "filters": {}
     },
     "timeout_s": 30,
     "effect": "read_only",
     "purpose": "Search the index for what a user may read.",
     "returns_doc": "passages: at most k, ordered by score from highest to lowest, each with its id, text, score, source and permissions. An empty list when nothing matches; that is not an error.",
     "errors": [
      {
       "code": "invalid_argument",
       "when": "k is below 1, or the query is empty.",
       "probe": {
        "user": "u",
        "query": "q",
        "k": 0,
        "filters": {}
       }
      },
      {
       "code": "permission_denied",
       "when": "The user may not read anything (the plugin, not the harness, enforces access).",
       "probe": {
        "user": "__no_access__",
        "query": "q",
        "k": 1,
        "filters": {}
       }
      },
      {
       "code": "unavailable",
       "when": "The index backend is down.",
       "probe": null
      },
      {
       "code": "rate_limited",
       "when": "The embedding or index backend refused the call for now.",
       "probe": null
      }
     ]
    },
    "forget": {
     "input": {
      "type": "object",
      "properties": {
       "ids": {
        "type": "array",
        "items": {
         "type": "string"
        }
       }
      },
      "required": [
       "ids"
      ],
      "additionalProperties": true
     },
     "output": {
      "type": "object",
      "properties": {
       "removed": {
        "type": "integer"
       }
      },
      "required": [
       "removed"
      ],
      "additionalProperties": true
     },
     "sample": {
      "ids": [
       "__conformance_doc__"
      ]
     },
     "timeout_s": 30,
     "effect": "write",
     "purpose": "Remove documents from the index. Idempotent.",
     "returns_doc": "removed: how many of the ids were present. Removing an id that is not there is not an error.",
     "errors": [
      {
       "code": "invalid_argument",
       "when": "The list of ids is empty.",
       "probe": {
        "ids": []
       }
      },
      {
       "code": "unavailable",
       "when": "The index backend is down.",
       "probe": null
      }
     ]
    }
   }
  },
