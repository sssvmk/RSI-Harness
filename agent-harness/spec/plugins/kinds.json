 "error_codes": {
  "invalid_argument": {
   "retryable": false,
   "meaning": "The arguments are well-formed but not acceptable (an empty id, k below 1, an action without a type). Arguments are validated before any resource is looked up."
  },
  "not_found": {
   "retryable": false,
   "meaning": "The session, fork or sandbox that the call names does not exist."
  },
  "permission_denied": {
   "retryable": false,
   "meaning": "The caller may not do this. The plugin enforces it; the harness does not rely on the model to."
  },
  "conflict": {
   "retryable": false,
   "meaning": "The request conflicts with the current state."
  },
  "unsupported": {
   "retryable": false,
   "meaning": "The plugin does not support this request (an unknown tier or environment)."
  },
  "unavailable": {
   "retryable": true,
   "meaning": "A backend that the plugin depends on is down or cannot be reached."
  },
  "rate_limited": {
   "retryable": true,
   "meaning": "A limit of a backend was reached; try again later."
  }
 },
 "probe_conventions": {
  "reserved_ids": {
   "user": "__no_access__ (has no permissions on anything)",
   "session": "__no_such_session__",
   "fork": "__no_such_fork__",
   "sandbox": "__no_such_sandbox__"
  },
  "rule": "A probe is a safe input that must make the method raise exactly the named error without changing state. A plugin must treat each reserved id as nonexistent or unauthorized. Because probes are run when a plugin is loaded, they never touch real data."
 },
 "conformance_rule": "Conformance calls every method with its sample on the live plugin. A sample for a method with side effects uses a reserved id that no real data can have (__conformance_doc__, __conformance_user__). An id that a plugin creates (a session, a fork, a sandbox) is taken from the result of the creating call and used by the calls that follow it, so a plugin is never expected to hand out a particular id, and what it created is closed, stopped or destroyed by the end of the sequence."
}